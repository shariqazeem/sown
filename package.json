{
  "name": "sown",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Send money home. Part of it stays theirs.",
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:build": "scripts/contract-build.sh",
    "contract:test": "cargo test -p sown",
    "contract:deploy:testnet": "tsx scripts/deploy.ts testnet",
    "contract:deploy:mainnet": "tsx scripts/deploy.ts mainnet",
    "battery:testnet": "tsx scripts/battery.ts",
    "smoke:mainnet": "tsx scripts/smoke-mainnet.ts",
    "measure": "tsx scripts/measure.ts",
    "preflight": "tsx scripts/preflight.ts",
    "smoke:day0": "tsx scripts/smoke/aquarius-testnet.ts && tsx scripts/smoke/mainnet-pools.ts && tsx scripts/smoke/kit-testnet.ts"
  },
  "dependencies": {
    "@creit-tech/stellar-wallets-kit": "npm:@jsr/creit-tech__stellar-wallets-kit@2.5.0",
    "@stellar/stellar-sdk": "16.3.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.21.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "^0.0.1",
    "smart-account-kit": "0.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6"
  }
