# Copy to .env.local (never committed). The network every surface serves:
NEXT_PUBLIC_SOWN_NETWORK=testnet
# The final origin. Passkeys are bound to it: a wallet made on one domain cannot open on another.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Sown's servers: the account that pays for recipients' wallets, trustlines and claims.
SOWN_SPONSOR_SECRET=S...
# Optional: a paid RPC endpoint (server and browser), and the cache file ("" turns it off).
# SOWN_RPC_URL=https://...
# NEXT_PUBLIC_SOWN_RPC_URL=https://...
# SOWN_DB=var/sown.testnet.db
# Optional: a Telegram alert when the sponsor holds under 20 XLM.
# TELEGRAM_BOT_TOKEN=
# SOWN_ALERT_CHAT_ID=
