# Copy to .env.local (never committed). The network every surface serves:
NEXT_PUBLIC_SOWN_NETWORK=testnet
# The final origin. Passkeys are bound to it: a wallet made on one domain cannot open on another.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Sown's servers: the account that pays for recipients' wallets, trustlines and claims.
SOWN_SPONSOR_SECRET=S...
# Where /proof and the footer link to the code.
NEXT_PUBLIC_REPO_URL=https://github.com/shariqazeem/sown
# Optional: a paid RPC endpoint (server and browser), and the cache file ("" turns it off).
# SOWN_RPC_URL=https://...
# NEXT_PUBLIC_SOWN_RPC_URL=https://...
# SOWN_DB=var/sown.testnet.db
# Optional: a Telegram alert when the sponsor holds under SOWN_SPONSOR_LOW_XLM (default 20).
# TELEGRAM_BOT_TOKEN=
# SOWN_ALERT_CHAT_ID=
# SOWN_SPONSOR_LOW_XLM=20
# Optional: the relay's limits (requests per IP per window; moves out of one wallet per day).
# SOWN_RELAY_PER_IP=30
# SOWN_RELAY_MOVES_PER_DAY=5
# Testnet only: list "Test wallet in this browser" beside Freighter and the others, so a send can be
# tried without installing a wallet. Ignored on mainnet.
# NEXT_PUBLIC_SOWN_TEST_WALLET=1
